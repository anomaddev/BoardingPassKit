{
  "name": "boardingpasskit/boarding-pass-kit",
  "description": "IATA BCBP boarding pass barcode decoder (Rust core via PHP FFI)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-ffi": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "BoardingPassKit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BoardingPassKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php -d ffi.enable=true vendor/bin/phpunit"
  }
}
